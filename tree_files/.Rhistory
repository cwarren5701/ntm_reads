print(planet_lab_id)
print(pull(filter(meta, `Planet Lab ID` == planet_lab_id), `Collection Date`))
print(length(NTM_thresher_meta$collection_date[genome = g]))
date = pull(filter(meta, `Planet Lab ID` == planet_lab_id), `Collection Date`)
if (length(date) > 0) {
NTM_thresher_meta$collection_date[NTM_thresher_meta$genome == g] <- date
}
}
NTM_thresher_meta$collection_date[NTM_thresher_meta$genome == IDDLNTM5] <- "11/4/13"
NTM_thresher_meta$collection_date[NTM_thresher_meta$genome == "IDDLNTM5"] <- "11/4/13"
test <- sub("^(IDDL)0+", "\\1", IDDL02)
test <- sub("^(IDDL)0+", "\\1", "IDDL02")
print(test)
test <- sub("^(IDDL)0+", "\\1", "IDDL100")
print(test)
meta$`Planet Lab ID` <- subsub("^(IDDL)0+", "\\1", meta$`Planet Lab ID`)
meta$`Planet Lab ID` <- sub("^(IDDL)0+", "\\1", meta$`Planet Lab ID`)
tip_labels <- tree$tip.label
tip_labels_num_only <- str_remove(tip_labels, "^IDDLNTM")
tip_labels_num_only <- str_c("IDDL", tip_labels_num_only)
tip_labels_table <- tibble(
tip_label = tip_labels,
cleaned_tip_label = str_remove(tip_labels_num_only, "\\.[ABC]$"),
PT_num_col = ""
)
planet_lab_IDs <- (meta %>% pull(`Planet Lab ID`))
count <- 0
tree_with_PT <- tree
for (ID in tip_labels_table$cleaned_tip_label) {
if (ID %in% planet_lab_IDs) {
# gets the real tip label that corresponds with the cleaned one (could be more than one because of A, B, C extensions)
real_tip_labels <- pull(filter(tip_labels_table, cleaned_tip_label == ID), tip_label)
for (label in real_tip_labels) {
# get PT# from cleaned label - A, B, or C duplicates will share same PT#
PT_num <- pull(filter(meta, `Planet Lab ID` == ID), `PT#`)
tree_with_PT$tip.label[tree_with_PT$tip.label == label] <- paste(tree_with_PT$tip.label[tree_with_PT$tip.label == label], PT_num, sep = ".")
tip_labels_table$PT_num_col[tip_labels_table$cleaned_tip_label == ID] <- PT_num
count <- count + 1
}
}
}
print(count)
write.tree(tree_with_PT, file = "CHOP_ntm_with_PT_num.treefile")
for (g in NTM_thresher_meta$genome) {
planet_lab_id = pull(filter(tip_labels_table, tip_label == g), cleaned_tip_label)
print(planet_lab_id)
print(pull(filter(meta, `Planet Lab ID` == planet_lab_id), `Collection Date`))
print(length(NTM_thresher_meta$collection_date[genome = g]))
date = pull(filter(meta, `Planet Lab ID` == planet_lab_id), `Collection Date`)
if (length(date) > 0) {
NTM_thresher_meta$collection_date[NTM_thresher_meta$genome == g] <- date
}
}
